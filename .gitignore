.venv/
.deps/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
listing_pipeline_data/*
!listing_pipeline_data/config.example.toml
# Scan output: reference-image cache, card crops, thumbnails, and archived
# sheets (a single 600dpi sheet is ~70MB). All reproducible from a rescan or
# a cache-set, none of it source. Same shape as listing_pipeline_data above.
scan_ingest_data/*
!scan_ingest_data/session.env.example
captured_cards/
*.egg-info/
*.db-wal
*.db-shm
# Favicon / og:image PNGs rasterised on first request from brand.py's own
# stroke geometry (see storefront/favicon.py) -- reproducible, not source.
storefront/.generated-assets/
# User-uploaded photos for Personal Collection items with no clean catalogue
# image available (see automation_control/personal_collection.py) -- real
# user data, not source.
static/personal_collection_photos/*
!static/personal_collection_photos/.gitkeep


# Generated eBay File Exchange exports and ad-hoc CSV reports -- all
# reproducible from the scripts that made them (export_ebay_bulk_listing.py,
# convert_to_ebay_template.py, export_cards_by_set_review.py), none of it
# source. Keeps them out of `git status` without deleting anything on disk.
/ebay_bulk_listing*.csv
/ebay_variation*.csv
/ebay-category-listing-template.csv
/cards_by_set_review.csv
