# Config for the scan-ingest background service (scan-ingest.service).
# Copy to session.env and edit -- session.env is gitignored, this example
# file is not.
#
# Leave SET_ID blank (the default) to auto-detect which set -- and which
# way up -- every scanned sheet is, from whichever sets you've cached:
#   .venv/bin/python -m automation_control.scan_ingest.cli cache-set --set-id <id>
# Cache a set once, then just scan; no restart needed to switch piles as
# long as the new pile's set is already cached. A sheet that doesn't
# confidently match anything cached is left in the watch folder rather than
# guessed at -- check the log/status page (/scan-ingest).
#
# Set SET_ID to pin this service to one fixed set instead (skips the
# per-sheet detection, and ROTATE below then applies):
#   sudo systemctl restart scan-ingest

SET_ID=
VARIANT=normal
CONDITION="Near Mint"

# Only used when SET_ID is set above.
# EXPECTED_COUNT=9
# ROTATE=0
