[Unit]
Description=Refresh the eBay active-listings cache every 10 minutes

[Timer]
# Five minutes after the ten-minutely order import. This keeps the CRM's
# active-listing count close to eBay without making both jobs compete for
# the API and database at the same moment.
OnCalendar=*-*-* *:05/10:00
RandomizedDelaySec=45
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
