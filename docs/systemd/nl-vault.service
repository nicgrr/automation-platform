[Unit]
Description=NL Vault private storefront
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ezbay
Group=ezbay
UMask=0002
WorkingDirectory=/home/nic/automation-platform
ExecStart=/bin/bash /home/nic/automation-platform/scripts/start-storefront.sh
Restart=on-failure
RestartSec=10
MemoryMax=512M

[Install]
WantedBy=multi-user.target
