[Unit]
Description=EzBay daily eBay listing traffic refresh for /analytics (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ezbay
Group=ezbay
WorkingDirectory=/home/nic/automation-platform
ExecStart=/bin/bash /home/nic/automation-platform/scripts/run-ebay-traffic-refresh.sh
StandardOutput=append:/home/nic/automation-platform/scan_ingest_data/logs/ebay-traffic-refresh.log
StandardError=append:/home/nic/automation-platform/scan_ingest_data/logs/ebay-traffic-refresh.log
