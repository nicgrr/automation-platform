[Unit]
Description=EzBay daily TCGCSV bulk catalogue and price sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ezbay
Group=ezbay
WorkingDirectory=/home/nic/automation-platform
ExecStart=/bin/bash /home/nic/automation-platform/scripts/run-tcgcsv-pricing-sync.sh
TimeoutStartSec=1800
StandardOutput=append:/home/nic/automation-platform/scan_ingest_data/logs/tcgcsv-pricing-sync.log
StandardError=append:/home/nic/automation-platform/scan_ingest_data/logs/tcgcsv-pricing-sync.log
