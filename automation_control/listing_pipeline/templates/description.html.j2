<div style="font-family: Arial, Helvetica, sans-serif; max-width: 100%; color: #222; line-height: 1.5;">
  <h2 style="margin: 0 0 8px 0; font-size: 20px;">{{ listing.custom_label }}</h2>
  {% if is_bundle %}
  <p style="margin: 0 0 12px 0;">This bundle includes {{ cards | length }} cards:</p>
  {% endif %}
  <ul style="list-style: none; margin: 0 0 12px 0; padding: 0;">
    {% for card in cards %}
    <li style="border: 1px solid #ddd; border-radius: 6px; padding: 10px; margin-bottom: 8px;">
      <div style="font-weight: bold; font-size: 16px;">{{ card.character }}</div>
      <div style="font-size: 14px; color: #555;">{{ card.set_name }} &middot; #{{ card.card_number }} &middot; {{ card.rarity }}</div>
    </li>
    {% endfor %}
  </ul>
  <div style="border-top: 1px solid #ddd; padding-top: 10px;">
    <div style="font-weight: bold; font-size: 15px;">Condition</div>
    <div style="font-size: 14px; color: #333;">{{ condition_summary }}</div>
  </div>
</div>
