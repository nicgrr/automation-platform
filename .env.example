# Placeholder names only. Do not put real credentials in this file.
AUTOMATION_DATABASE_URL=sqlite:///./automation.db
GROCERY_BASE_URL=http://grocery-web:8000
DOCKER_BROKER_URL=http://docker-broker:8081
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8080
APP_PUBLIC_BASE_URL=
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD_HASH=
SESSION_SIGNING_KEY=
EBAY_TOKEN_ENCRYPTION_KEY=
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# Optional landed-cost ceiling in AUD for new-listing alerts.
MARKET_ALERT_MAX_LANDED_AUD=
# Comma-separated ISO seller locations allowed in market search/watch.
MARKET_ALLOWED_COUNTRIES=AU,JP
# Optional public-web discovery. Enable storage only when your Brave plan
# explicitly grants rights to retain API results.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_PERMITTED=false
MARKET_PUBLIC_SEARCH_DOMAINS=gumtree.com.au,depop.com,buyee.jp,zenmarket.jp,fromjapan.co.jp
# Optional dedicated alert mailbox; .eml upload works without it.
MARKET_ALERT_IMAP_HOST=
MARKET_ALERT_IMAP_PORT=993
MARKET_ALERT_IMAP_USERNAME=
MARKET_ALERT_IMAP_PASSWORD=
MARKET_ALERT_IMAP_MAILBOX=INBOX
MARKET_ALERT_IMAP_USE_SSL=true
ANTHROPIC_API_KEY=
POKEMONPRICETRACKER_API_KEY=
# Multi-source pricing remains free-only unless deliberately enabled.
ALLOW_PAID_PRICING=false
PRICING_EBAY_DAILY_BUDGET=300
PRICING_ACTIVE_CACHE_HOURS=12
PRICING_HIGH_VALUE_CACHE_HOURS=24
PRICING_STANDARD_CACHE_DAYS=7
PRICING_BULK_CACHE_DAYS=30
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
